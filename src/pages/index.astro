---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { releases } from '../data/releases';
const featured = releases[0];
---
<Layout>
  <section class="page-intro" aria-labelledby="home-title">
    <h1 id="home-title">Jonathan Chiu</h1>
    <div class="intro-copy">
      <p>Software engineer.<br />Music as <a href="/music/">Choo</a>.</p>
    </div>
  </section>

  <section class="home-feature" aria-labelledby="featured-title">
    <div class="section-heading">
      <h2 class="eyebrow" id="featured-title">Selected music</h2>
      <a href="/music/">All releases <span aria-hidden="true">↗</span></a>
    </div>
    <div class="feature-grid">
      <div class="feature-copy">
        <span class="eyebrow">Choo / {featured.date.slice(0, 4)}</span>
        <h3><a href={`/music/#${featured.track}`}>{featured.title}</a></h3>
        <a class="feature-listen" href={`/music/#${featured.track}`}>Listen <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="featured-artwork">
        <a class="release-artwork" href={`/music/#${featured.track}`} aria-label={`Listen to ${featured.title}`}>
          <Image src={featured.artwork} alt={`${featured.title} cover artwork`} widths={[480, 720, 960, 1440]} sizes="(max-width: 700px) calc(100vw - 40px), (min-width: 1824px) 1128px, 62vw" loading="eager" fetchpriority="high" />
        </a>
        <figcaption class="artwork-caption"><span>01 / {featured.title}</span><span>{featured.date.slice(0, 4)}</span></figcaption>
      </figure>
    </div>
  </section>
</Layout>
