---
import PhotoImage from '../components/PhotoImage.astro';
import PhotoLightbox from '../components/PhotoLightbox.astro';
import PhotoCaption from '../components/PhotoCaption.astro';
import Layout from '../layouts/Layout.astro';
import home from '../assets/photos/home.jpg';
import korea from '../assets/photos/korea.jpeg';
---
<Layout>
  <section class="about-page" aria-labelledby="home-title">
    <h1 id="home-title">I’m Jonathan.</h1>
    <div class="about-content">
      <div class="about-copy">
        <div>
        <p>Things I care about:</p>
        <ul class="about-interests">
          <li><a href="https://en.wikipedia.org/wiki/Chinatown,_Manhattan" target="_blank" rel="noopener noreferrer">Chinatown <span aria-hidden="true">↗</span></a></li>
          <li><a href="/media/#movies">Film</a></li>
          <li><a href="/music/">Music</a></li>
          <li>Public transportation</li>
        </ul>
        </div>
        <div>
        <p>Things I enjoy:</p>
        <ul class="about-interests">
          <li><a href="/photography/">Photography</a></li>
          <li>Running</li>
          <li>Weightlifting</li>
          <li>Whatever that feeling that washes over you is when you're sitting by an open window, sunset over the horizon, and a cool, gentle breeze rolls in</li>
        </ul>
        </div>
        <div>
        <p>Things that intrigue me:</p>
        <ul class="about-interests">
          <li><a href="https://en.wikipedia.org/wiki/Nostalgia" target="_blank" rel="noopener noreferrer">Nostalgia <span aria-hidden="true">↗</span></a></li>
          <li><a href="https://en.wikipedia.org/wiki/Time_dilation" target="_blank" rel="noopener noreferrer">Time dilation <span aria-hidden="true">↗</span></a></li>
          <li><a href="https://en.wikipedia.org/wiki/Timeline_of_the_far_future" target="_blank" rel="noopener noreferrer">Timeline of the far future <span aria-hidden="true">↗</span></a></li>
        </ul>
        </div>
      </div>
    </div>
    <div class="about-photos">
        <figure>
          <PhotoImage src={home} alt="Jonathan sitting at a table in a film photograph with a warm light leak." widths={[380, 760, 1140]} sizes="(max-width: 420px) calc(100vw - 40px), (max-width: 700px) 380px, (max-width: 1300px) 30vw, 380px" loading="eager" />
          <PhotoCaption location="At home" date="2019-07-29" />
        </figure>
        <figure>
          <PhotoImage src={korea} alt="Jonathan standing beside a pond in front of a pavilion in Korea." widths={[380, 760, 1140]} sizes="(max-width: 420px) calc(100vw - 40px), (max-width: 700px) 380px, (max-width: 1300px) 30vw, 380px" loading="lazy" />
          <PhotoCaption location="Somewhere inside Gyeongbokgung Palace, Seoul, South Korea" date="2019-09-02" />
        </figure>
    </div>
  </section>
  <PhotoLightbox />
</Layout>
