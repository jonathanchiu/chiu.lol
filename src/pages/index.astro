---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
import { releases } from '../data/releases';
const featured = releases[0];
---
<Layout>
  <section class="intro" aria-labelledby="hello">
    <h1 id="hello">Hello<span class="accent">.</span><br />I'm <span class="name-highlight">Jon</span>athan.</h1>
    <div class="intro-bottom">
      <p class="intro-description">Software engineer. Music as <a class="inline-link" href="/music/">Choo</a>.</p>
      <a class="text-link" href={`mailto:${site.email}`}>Email <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="about-section" aria-labelledby="about-title">
    <div class="section-label"><span class="section-number">01 /</span><h2 id="about-title">About</h2></div>
    <div class="about-copy">
      <p>Computer Science at <a class="inline-link" href="https://www.northeastern.edu/">Northeastern University</a>.</p>
      <a class="text-link" href={site.links.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="music-section" aria-labelledby="music-title">
    <div class="section-label"><span class="section-number">02 /</span><h2 id="music-title">Music</h2></div>
    <div class="featured-music">
      <a class="featured-artwork" href="/music/" aria-label="Music by Choo">
        <Image src={featured.artwork} alt="Who Cares? cover artwork" widths={[320, 480, 640]} sizes="(max-width: 600px) 100vw, 320px" width={640} height={640} />
        <span class="artwork-link" aria-hidden="true">↗</span>
      </a>
      <div class="featured-copy">
        <p class="eyebrow">Choo</p>
        <h3>{featured.title}</h3>
        <p>April 20th, 2021</p>
        <a class="text-link" href="/music/">Listen <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <section class="goodbye" aria-labelledby="goodbye-title">
    <h2 id="goodbye-title">Goodbye<span class="accent">.</span></h2>
    <a class="text-link email-link" href={`mailto:${site.email}`}>{site.email} <span aria-hidden="true">↗</span></a>
  </section>
</Layout>
