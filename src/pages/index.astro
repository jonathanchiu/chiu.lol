---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { releases } from '../data/releases';
---
<Layout>
  <div class="home-composition">
    <h1 class="home-title">Jonathan Chiu</h1>

    <section class="home-profile" aria-label="About Jonathan">
      <p>Software engineer.<br />Music as <a class="inline-link" href="/music/">Choo</a>.</p>
      <p>Computer Science at <a class="inline-link" href="https://www.northeastern.edu/">Northeastern University</a>.</p>
    </section>

    <section class="home-music" aria-labelledby="music-title">
      <div class="gallery-heading"><h2 class="eyebrow" id="music-title">Music</h2><a class="inline-link" href="/music/">All releases</a></div>
      <div class="home-gallery">
        {releases.map((release) => (
          <figure class="home-release">
            <a class="release-artwork" href={`/music/#${release.track}`} aria-label={`Listen to ${release.title}`}>
              <Image src={release.artwork} alt={`${release.title} cover artwork`} widths={[240, 400, 640, 960]} sizes="(max-width: 900px) 50vw, 25vw" width={960} height={960} />
            </a>
            <figcaption><h3><a href={`/music/#${release.track}`}>{release.title}</a></h3><span>{release.date.slice(0, 4)}</span></figcaption>
          </figure>
        ))}
      </div>
    </section>
  </div>
</Layout>
