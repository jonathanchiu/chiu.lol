---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { releases } from '../data/releases';
import { site } from '../data/site';
const formatDate = (date: string) => new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(new Date(date));
---
<Layout title="Music by Choo" description="Songs by Choo, the music project of Jonathan Chiu. Listen to Who Cares?, Fool, Breathe, and Everytime.">
  <section class="intro music-intro" aria-labelledby="listen">
    <h1 id="listen">Listen<span class="accent">.</span></h1>
    <p class="intro-description">I (rarely) make music under the name Choo.</p>
    <div class="platform-links" aria-label="Listen to Choo">
      <a href={site.links.spotify}>Spotify <span aria-hidden="true">↗</span></a>
      <a href={site.links.appleMusic}>Apple Music <span aria-hidden="true">↗</span></a>
      <a href={site.links.soundcloud}>SoundCloud <span aria-hidden="true">↗</span></a>
    </div>
  </section>
  <section class="releases" aria-labelledby="releases-title">
    <div class="releases-heading"><h2 class="eyebrow" id="releases-title">Releases</h2><span class="eyebrow">2019 — 2021</span></div>
    <div class="release-grid">
      {releases.map((release, index) => (
        <article class="release">
          <a class="release-artwork" href={`https://open.spotify.com/track/${release.track}`} aria-label={`Listen to ${release.title} on Spotify`}>
            <Image src={release.artwork} alt={`${release.title} cover artwork`} widths={[320, 480, 720, 960]} sizes="(max-width: 600px) 100vw, 50vw" width={960} height={960} loading={index === 0 ? 'eager' : 'lazy'} />
            <span class="artwork-link" aria-hidden="true">↗</span>
          </a>
          <div class="release-meta"><h3>{release.title}</h3><span class="release-type">Single / {release.date.slice(0, 4)}</span></div>
          <time datetime={release.date}>{formatDate(release.date)}</time>
          <details class="listen-details">
            <summary>Listen to {release.title} <span aria-hidden="true">+</span></summary>
            <div class="player-slot" data-track={release.track} data-title={release.title}></div>
            <a class="player-fallback" href={`https://open.spotify.com/track/${release.track}`}>Open in Spotify ↗</a>
          </details>
          {release.youtube && <a class="video-link" href={release.youtube}>Watch the music video <span aria-hidden="true">↗</span></a>}
        </article>
      ))}
    </div>
  </section>
</Layout>
<script>
  // Contact Spotify only after the visitor chooses to open a player.
  document.querySelectorAll<HTMLDetailsElement>('.listen-details').forEach((details) => {
    details.addEventListener('toggle', () => {
      const slot = details.querySelector<HTMLElement>('.player-slot');
      if (!slot) return;
      if (!details.open) {
        slot.replaceChildren(); // Stop playback when the player is closed.
        return;
      }
      if (slot.childElementCount) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://open.spotify.com/embed/track/${slot.dataset.track}?theme=0`;
      iframe.title = `Listen to ${slot.dataset.title} by Choo on Spotify`;
      iframe.allow = 'autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture';
      iframe.height = '152';
      iframe.width = '100%';
      slot.append(iframe);
    });
  });
</script>
