---
import '@fontsource-variable/archivo';
import '../styles/global.css';
import { site } from '../data/site';
interface Props { title?: string; description?: string; noindex?: boolean; }
const { title = site.name, description = site.description, noindex = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{title} — chiu.lol</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="chiu.lol" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="twitter:card" content="summary" />
    {noindex && <meta name="robots" content="noindex" />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="wordmark" href="/" aria-label="Jonathan Chiu, home">chiu.lol</a>
        <nav aria-label="Main navigation">
          <a href="/" aria-current={path === '/' ? 'page' : undefined}>About</a>
          <a href="/music/" aria-current={path === '/music' ? 'page' : undefined}>Music</a>
          <a class="nav-contact" href={`mailto:${site.email}`}>Email</a>
        </nav>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <span class="copyright">© {new Date().getFullYear()} Jonathan Chiu</span>
        <div class="footer-links">
          <a href={site.links.instagram}>Instagram</a>
          <a href={site.links.linkedin}>LinkedIn</a>
        </div>
      </footer>
    </div>
  </body>
</html>
