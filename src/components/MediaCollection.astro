---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  id: string;
  title: string;
  source: string;
  sourceUrl: string;
  items: { title: string; year: number; director: string; poster: ImageMetadata; url: string; format?: string }[];
  credits?: { name: string; url: string }[];
  preserveArtwork?: boolean;
  eager?: boolean;
}
const { id, title, source, sourceUrl, items, eager = false, preserveArtwork = false, credits = [{ name: source, url: sourceUrl }] } = Astro.props;
---
<section class:list={['media-collection', { 'media-collection--uncropped': preserveArtwork }]} aria-labelledby={id}>
  <div class="section-heading media-section-heading">
    <h2 class="eyebrow" id={id}>{title}</h2>
  </div>
  <ul class="film-grid">
    {items.map((item, index) => (
      <li class="film">
        <figure>
          <a class="film-poster" href={item.url} target="_blank" rel="noopener noreferrer" aria-label={`More about ${item.title} (${item.year})`}>
            <Image src={item.poster} alt={`${item.title} poster`} widths={[...new Set([160, 240, 480, 600, item.poster.width].filter((width) => width <= item.poster.width))].sort((a, b) => a - b)} quality={85} sizes="(max-width: 560px) 45vw, 240px" loading={eager && index < 3 ? 'eager' : 'lazy'} />
          </a>
          <figcaption>
            <div class="film-title"><h3><a href={item.url} target="_blank" rel="noopener noreferrer">{item.title} <span aria-hidden="true">↗</span></a></h3><span class="eyebrow">{item.year}</span></div>
            <p class="film-director eyebrow">{item.director}{item.format && ` · ${item.format}`}</p>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>
  <p class="media-credit eyebrow">Posters and details via {credits.map((credit, index) => <>{index > 0 && ' and '}<a href={credit.url} target="_blank" rel="noopener noreferrer">{credit.name} <span aria-hidden="true">↗</span></a></>)}</p>
</section>
